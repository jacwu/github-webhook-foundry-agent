# Your Azure AI Foundry project endpoint URL
# Find this in the Azure AI Foundry portal under project settings
PROJECT_ENDPOINT=https://your-project-name.region.api.azureml.ms

# Your model deployment name (e.g., gpt-4, gpt-35-turbo, gpt-4-turbo)
MODEL_DEPLOYMENT_NAME=gpt-4

# Full resource path to your Bing Search connection
# Format: /subscriptions/{sub_id}/resourceGroups/{rg}/providers/Microsoft.CognitiveServices/accounts/{account}/projects/{project}/connections/{connection}
# Find this in Azure AI Foundry portal -> Settings -> Connected Resources
BING_CONNECTION_NAME=/subscriptions/YOUR_SUBSCRIPTION_ID/resourceGroups/YOUR_RESOURCE_GROUP/providers/Microsoft.CognitiveServices/accounts/YOUR_ACCOUNT/projects/YOUR_PROJECT/connections/YOUR_BING_CONNECTION

# Azure Active Directory service principal credentials (used by DefaultAzureCredential)
# Make sure to assign the service principal the "Azure AI Project Manager" role on the Foundry project scope
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_SECRET=your-client-secret-value

# Your Azure AI Foundry agent ID, generated after creating the agent
AIFOUNDRY_AGENT_ID=foundry-agent-id


# GitHub Webhook Configuration (for webhook handler)
GITHUB_WEBHOOK_SECRET=your-webhook-secret-here

# GitHub Personal Access Token with repo permissions (for posting comments)
GITHUB_TOKEN=ghp_your_github_personal_access_token


